generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // یا "postgresql" یا "mysql"
  url      = env("DATABASE_URL")
}

// مدل User رو حتماً اضافه کن
model User {
  id              String          @id @default(cuid())
  email           String?         @unique
  phone           String?         @unique
  passwordHash    String?
  fullName        String?
  isVerified      Boolean         @default(false)
  recoveryMethods Json?           // روش‌های بازیابی
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  trustedDevices  TrustedDevice[]
  otpCodes        OtpCode[]
  sessions        AuthSession[]
  activities      ActivityLog[]
  
  @@unique([email, phone])
}

// بعد بقیه مدل‌ها رو اضافه کن
model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String    @unique
  deviceName        String
  deviceType        String
  browser           String
  os                String
  ipAddress         String?
  lastUsedAt        DateTime  @default(now())
  firstSeenAt       DateTime  @default(now())
  
  @@index([userId])
}

model OtpCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  type        String
  deviceId    String?
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([code])
}

model AuthSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  
  @@index([userId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  deviceId    String?
  details     Json?
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([action])
}